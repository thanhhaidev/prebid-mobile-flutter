{
  "dart.flutterSdkPath": ".fvm/flutter_sdk",
  "gradle.nestedProjects": ["example/android"],
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
